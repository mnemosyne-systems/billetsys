# Copy to src/frontend/.env and adjust for non-default Keycloak setups.
# The built-in defaults in src/frontend/src/auth/keycloak.ts already match
# the local setup (http://localhost:8180, realm billetsys).
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=billetsys
VITE_KEYCLOAK_CLIENT_ID=billetsys-frontend
